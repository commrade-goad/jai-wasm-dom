#template
AppShell :: () {
    <div class="app">
        <header class="app-header">
            <div>
                <h1>Jai SPA</h1>
                <p class="muted">Templates build the DOM; Jai owns the state.</p>
            </div>
            <nav class="tabs">
                <button id="nav-counter" class="tab">Counter</button>
                <button id="nav-todos" class="tab">Todos</button>
            </nav>
        </header>
        <section id="view" class="view"></section>
        <footer class="app-footer">
            <p class="muted">View and filter state live in Jai. The address bar is left alone.</p>
        </footer>
    </div>
}

#template
CounterView :: () {
    <section id="counter-view" class="panel">
        <h2>Counter</h2>
        <p class="muted">The count lives in Jai memory and is read back through the DOM.</p>
        <div class="counter-row">
            <button id="counter-dec" class="btn">-</button>
            <output id="counter-value" class="counter-value">0</output>
            <button id="counter-inc" class="btn">+</button>
        </div>
        <button id="counter-reset" class="btn btn-ghost">Reset</button>
    </section>
}

#template
TodosView :: () {
    <section id="todos-view" class="panel">
        <h2>Todos</h2>
        <p class="muted">Add items, toggle them, filter, and switch views without a reload.</p>
        <div class="todo-form">
            <input id="todo-input" class="todo-input" type="text" placeholder="What needs doing?" />
            <button id="todo-add" class="btn" onclick="{todo_add_clicked}">Add</button>
        </div>
        <div class="filters">
            <button id="filter-all"    onclick="{filter_all_clicked}" class="chip">All</button>
            <button id="filter-active" onclick="{filter_active_clicked}" class="chip">Active</button>
            <button id="filter-done"   onclick="{filter_done_clicked}" class="chip">Done</button>
        </div>
        <ul id="todo-list" class="todo-list"></ul>
        <p id="todo-empty" class="muted empty">No todos match this filter.</p>
        <p id="todo-count" class="muted"></p>
    </section>
}

#template
TodoRow :: (id: s32, text: string, done: bool) {
    <li class="{ ifx done then "todo done" else "todo" }" data-todo-id="{id}">
        <button class="todo-toggle">{ ifx done then "✓" else "○" }</button>
        <span class="todo-text">{text}</span>
        <button class="todo-delete">Delete</button>
    </li>
}
